# JAAL — Environment variables
# Copy this file to .env and fill in the real values.
# NEVER commit .env to git.

# Bob LLM API
BOB_API_KEY=your-bob-api-key-here
BOB_API_URL=https://api.bob.example.com/v1/chat/completions
MODEL_NAME=bob-large

# Extraction settings
TEMPERATURE=0.1
MAX_RETRIES=2
MAX_CHUNK_TOKENS=3000

# Set to 1 to bypass Bob and use regex fallback only (offline demo mode)
FORCE_FALLBACK=0

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
